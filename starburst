#!/usr/bin/env bash
# Run the Starburst CLI from a local jar, sourcing .env and auto-injecting
# connection flags for SEP-talking subcommands. Equivalent to:
#   alias starburst="java -jar $CLI_JAR"
# but resolves symlinks (so a link in ~/.local/bin still finds this repo's
# .env) and saves typing `--server $SERVER --user $USER --role $ROLE`.
set -euo pipefail
_script="${BASH_SOURCE[0]}"
REPO_ROOT="$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$_script")"
ENV_FILE="${ENV_FILE:-$REPO_ROOT/.env}"
# Source .env if it exists. In CI the env vars are already set, so missing
# .env is fine.
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi
# Fall back to the in-repo jar if CLI_JAR is unset or points at a missing file.
# Keeps the demo runnable when .env is stale, and lets CI just download the
# jar to the default path without setting CLI_JAR.
_default_jar="$REPO_ROOT/starburst-cli.jar"
if [[ -z "${CLI_JAR:-}" || ! -f "${CLI_JAR}" ]]; then
  if [[ -f "$_default_jar" ]]; then
    CLI_JAR="$_default_jar"
  else
    echo "CLI_JAR is unset or missing, and no jar found at $_default_jar." >&2
    echo "Either set CLI_JAR in $ENV_FILE or place the Starburst CLI jar at" >&2
    echo "  $_default_jar" >&2
    exit 1
  fi
fi
cd "$REPO_ROOT"

# Inject connection flags from .env for SEP-talking subcommands when the
# caller didn't pass them, so you don't have to type `--server "$SERVER"`
# every time (which fails anyway if .env isn't sourced into your shell first).
extra=()
if [[ $# -ge 2 && "$1" == "data-product" ]]; then
  case "$2" in
    import|export|publish|delete)
      has_server=0
      has_user=0
      has_role=0
      for a in "$@"; do
        case "$a" in
          --server | --server=*) has_server=1 ;;
          --user | --user=*) has_user=1 ;;
          --role | --role=*) has_role=1 ;;
        esac
      done
      [[ "$has_server" -eq 0 && -n "${SERVER:-}" ]] && extra+=(--server="$SERVER")
      [[ "$has_user" -eq 0 && -n "${STARBURST_USER:-}" ]] && extra+=(--user="$STARBURST_USER")
      [[ "$has_role" -eq 0 && -n "${ROLE:-}" ]] && extra+=(--role="$ROLE")
      ;;
  esac
fi

if ((${#extra[@]})); then
  exec java -jar "$CLI_JAR" "$@" "${extra[@]}"
else
  exec java -jar "$CLI_JAR" "$@"
fi
